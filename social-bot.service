# Als Dienst einrichten:
#   sudo cp social-bot.service /etc/systemd/system/
#   sudo systemctl enable --now social-bot
#   journalctl -u social-bot -f        # Log ansehen
[Unit]
Description=Stadtrat Social-Media-Bot (Telegram → Postiz)
After=network-online.target
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/stadtrat-social-bot
ExecStart=/usr/bin/node src/bot.mjs
Restart=always
RestartSec=10
Nice=5

[Install]
WantedBy=multi-user.target
