# Kopieren nach .env und ausfüllen:  cp .env.example .env

# --- Telegram ---
# Token von @BotFather
TELEGRAM_BOT_TOKEN=
# Telegram-IDs von Personen oder Gruppen, die den Bot benutzen dürfen (Komma-getrennt).
# Eine Gruppe freigeben = alle darin dürfen Vorschläge anlegen und freigeben (Gruppen-IDs sind negativ).
# Unbekannt? Dem Bot /id schreiben (in der Gruppe: /id in die Gruppe).
ERLAUBTE_NUTZER=
# Leer = api.telegram.org (Videos nur bis 20 MB).
# Mit lokalem Bot-API-Server (bis 2 GB, siehe README): http://localhost:8081
TELEGRAM_API_URL=

# --- Postiz (selbst gehostet) ---
# Adresse deiner Postiz-Instanz – mit oder ohne /api, z. B.
#   http://localhost:5000              (Postiz läuft auf demselben Pi)
#   http://192.168.1.20:5000           (anderer Rechner im Heimnetz)
#   https://postiz.example.de          (mit eigener Domain)
# Prüfen: /status im Bot
POSTIZ_URL=
# Postiz → Einstellungen → Developers → Public API
POSTIZ_API_KEY=
# Kunde, der standardmäßig gewählt ist (Name oder ID aus /kanaele). Leer = alle Kanäle.
POSTIZ_KUNDE=Lukas Küffner
# Kanäle, die standardmäßig angehakt sind: Name, @Handle oder ID aus /kanaele, kommagetrennt.
# Leer = alle des Kunden.
POSTIZ_KANAELE=
# Postiz erlaubt standardmäßig 30 API-Anfragen pro Stunde (API_LIMIT in der Postiz-Konfiguration).
# Der Bot zählt mit und sagt Bescheid, bevor es knapp wird. 0 = nicht mitzählen.
POSTIZ_MAX_ANFRAGEN=28
# Eigene Einstellungen je Netzwerk/Kanal (siehe kanaele.example.json)
KANAL_EINSTELLUNGEN=kanaele.json

# --- Mastodon direkt (optional) ---
# Postiz postet auf Mastodon immer öffentlich und ohne Inhaltswarnung. Mit diesen Angaben postet der Bot
# selbst – Mastodon-Kanäle in Postiz werden dann ausgeblendet.
# Token: auf der Instanz Einstellungen → Entwicklung → Neue Anwendung
# (Berechtigungen read:accounts, write:media, write:statuses)
MASTODON_URL=
MASTODON_TOKEN=
# unlisted (ungelistet), public oder private
MASTODON_SICHTBARKEIT=unlisted
# Inhaltswarnung für jeden Post, z. B. Kommunalpolitik – leer = keine
MASTODON_INHALTSWARNUNG=

# --- Spracherkennung (whisper.cpp) ---
WHISPER_BIN=/home/pi/whisper.cpp/build/bin/whisper-cli
WHISPER_MODELL=/home/pi/whisper.cpp/models/ggml-small.bin
WHISPER_THREADS=4
WHISPER_SPRACHE=de
# Namen und Begriffe, die Whisper richtig schreiben soll
GLOSSAR=glossar.txt

# --- Layout ---
LOGO=assets/logo.png
# oben-rechts, oben-links, unten-rechts, unten-links
LOGO_POSITION=oben-rechts
# Logobreite als Anteil der Videobreite
LOGO_BREITE=0.3
# halbtransparenter dunkler Kasten hinter dem Logo (ja/nein)
LOGO_HINTERGRUND=ja
# Logo standardmäßig auch auf Fotos (pro Beitrag per Knopf umschaltbar)
LOGO_AUF_FOTOS=ja
SCHRIFT=DejaVu Sans
# Ordner mit eigenen Schriftdateien (.ttf/.otf), optional
SCHRIFT_ORDNER=
UNTERTITEL_FARBE=#FFFFFF
UNTERTITEL_RAND=#000000
# rand = Schrift mit Kontur, box = Schrift auf Kasten
UNTERTITEL_STIL=rand
# Abstand vom unteren Rand (Anteil der Bildhöhe) – Platz für die Bedienelemente von Reels/TikTok
UNTERTITEL_POSITION=0.18

# --- Video ---
# libx264 (überall) oder h264_v4l2m2m (Hardware-Encoder Raspberry Pi 4)
VIDEO_ENCODER=libx264
VIDEO_PRESET=veryfast
VIDEO_CRF=21

# --- Caption-KI (optional) ---
# Mit Schlüssel schreibt eine KI die Caption, sonst gibt es einen einfachen Vorschlag.
# Achtung: Dann gehen Transkript, Fotos bzw. Text an den Anbieter (nicht lokal).
# claude oder openai – leer = automatisch der, für den ein Schlüssel eingetragen ist
CAPTION_ANBIETER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional: andere OpenAI-kompatible Adresse, z. B. ein lokales Modell (http://localhost:11434/v1 für Ollama)
OPENAI_BASE_URL=
# Leer = claude-opus-5-5 bzw. gpt-5.5
CAPTION_MODELL=
# Zusätzliche Stilvorgaben, z. B. „Immer mit Link zu kueffner.de enden“
CAPTION_STIL=
CAPTION_HASHTAGS=#Nürnberg #Stadtrat #Piraten

# --- Sonstiges ---
ZEITZONE=Europe/Berlin
DATEN_DIR=daten
